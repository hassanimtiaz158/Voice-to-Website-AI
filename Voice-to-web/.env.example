# --- shared
ENV=dev
# --- postgres (used by docker-compose)
POSTGRES_USER=codepilot
POSTGRES_PASSWORD=codepilot
POSTGRES_DB=codepilot
# --- api / worker
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@postgres:5432/codepilot
REDIS_URL=redis://redis:6379/0
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
# classic PAT (repo scope) for now; move to a GitHub App for production
GITHUB_TOKEN=
WORKSPACE_ROOT=/data/workspaces
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
